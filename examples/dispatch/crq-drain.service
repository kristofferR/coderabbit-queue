# systemd --user unit for the review drain. Install with:
#
#   cp examples/dispatch/crq-drain            ~/.local/bin/
#   cp examples/dispatch/fix-prompt.txt       ~/.local/share/crq/
#   cp examples/dispatch/crq-drain.service    ~/.config/systemd/user/
#   loginctl enable-linger "$USER"            # survive logout
#   systemctl --user enable --now crq-drain
#
# Restart=always plus linger is what makes it survive a logout, a crash, or a
# SIGKILL. Output goes to a file rather than the journal so a failing dispatch is
# greppable next to the session logs crq writes under $CRQ_WORKSPACE/logs.
[Unit]
Description=crq review drain (watch + dispatch fix sessions)
After=network-online.target

[Service]
Type=simple
Environment=CRQ_REPOS=owner/name
Environment=CRQ_WATCH_INTERVAL=5m
Environment=CRQ_DISPATCH_MAX_ATTEMPTS=3
Environment=CRQ_DISPATCH_CONCURRENCY=3
ExecStart=%h/.local/bin/crq-drain
Restart=always
RestartSec=20
StandardOutput=append:%h/.local/state/crq/drain.log
StandardError=append:%h/.local/state/crq/drain.err

[Install]
WantedBy=default.target
