#!/usr/bin/env bash
# Drive every open PR to convergence and start a fix session for the ones that
# need one.
#
# This is the piece a logging monitor is missing: it does not just record that a
# PR needs fixing, it dispatches something that fixes it. crq bounds that — one
# compare-and-swap-claimed session per PR, CRQ_DISPATCH_MAX_ATTEMPTS per head,
# CRQ_DISPATCH_CONCURRENCY at once — so leaving it running is safe.
#
# The fix session runs with permissions bypassed because it is unattended: an
# interactive prompt for `go test` or `git push` would simply hang forever. What
# keeps that safe is the prompt's scope and the isolated worktree, not a
# permission dialog nobody is there to answer.
set -uo pipefail

CRQ="${CRQ_BIN:-$HOME/.local/bin/crq}"
AGENT="${CRQ_DISPATCH_AGENT:-$HOME/.local/bin/claude}"
PROMPT="${CRQ_DISPATCH_PROMPT:-$HOME/.local/share/crq/fix-prompt.txt}"

exec "$CRQ" watch --dispatch -- \
  "$AGENT" -p "$(cat "$PROMPT")" --permission-mode bypassPermissions
